<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#102D22" android:paddingTop="32dp" android:paddingBottom="32dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:text="Scan your next meal" android:textColor="#E9F2E3" android:textSize="25sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="20dp" android:text="Point the camera at the package barcode." android:textColor="#BCCDBB" android:textSize="13sp" />
    <com.journeyapps.barcodescanner.DecoratedBarcodeView android:id="@+id/food_scanner" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="horizontal">
        <Button android:id="@+id/scanner_close" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cancel" />
        <Button android:id="@+id/scanner_torch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Light on" />
    </LinearLayout>
</LinearLayout>
